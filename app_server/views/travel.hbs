{{> header}}

<div id="background">
    <div id="page">
        <div id="contents">

            <div class="box">
                <div>
                    <div class="body">

                        <h1>Travel</h1>

                        <ul id="sites">

                            {{#each trips}}

                            <li>
                                <a href="/travel">
                                    <img src="{{this.image}}" alt="Img">
                                </a>

                                <h2>
                                    <a href="/travel">{{this.name}}</a>
                                </h2>

                                <p>
                                    {{this.description}}
                                </p>

                                <p>
                                    <strong>Code:</strong> {{this.code}} <br>
                                    <strong>Length:</strong> {{this.length}} <br>
                                    <strong>Start Date:</strong> {{this.start}} <br>
                                    <strong>Resort:</strong> {{this.resort}} <br>
                                    <strong>Price:</strong> {{this.perPerson}}
                                </p>
                            </li>

                            {{/each}}

                        </ul>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

{{> footer}}